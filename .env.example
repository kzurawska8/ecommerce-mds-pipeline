# Copy to .env (gitignored) and fill in. Values are read literally - no quotes.
# Account identifier: <organization_name>-<account_name>, as in terraform.tfvars.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=LOADER_USER
SNOWFLAKE_PRIVATE_KEY_FILE=keys/loader_user_rsa_key.p8
# Key passphrase: keep it out of this file. Export it in your shell instead:
#   read -rs SNOWFLAKE_PRIVATE_KEY_FILE_PWD && export SNOWFLAKE_PRIVATE_KEY_FILE_PWD
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
SNOWFLAKE_ROLE=LOADER_ROLE
SNOWFLAKE_WAREHOUSE=ECOMMERCE_WH
SNOWFLAKE_DATABASE=ECOMMERCE_DB
SNOWFLAKE_SCHEMA=RAW
